# EmailJS — create a free account at https://www.emailjs.com/
# Dashboard → Email Services / Email Templates / Account → API Keys
# The template must reference {{name}}, {{email}} and {{message}}.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Analytics 4 — measurement ID from the GA4 property (Admin → Data Streams).
# Analytics only loads when this is set. Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Google Search Console — the `content` value from the HTML-tag verification method.
# Renders <meta name="google-site-verification"> when set. Leave blank if unused.
NEXT_PUBLIC_GSC_VERIFICATION=
